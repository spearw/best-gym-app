# Copy to .env for local overrides; `make` loads it. Every variable the site reads is listed here.
# Local defaults work without a .env as long as `docker compose up -d db` is running.

DJANGO_SETTINGS_MODULE=config.settings.local
DATABASE_URL=postgres://gymtrainer:gymtrainer@localhost:5432/gymtrainer
SECRET_KEY=
ALLOWED_HOSTS=
CSRF_TRUSTED_ORIGINS=

# Phase 1: transactional email for invites and password reset.
# EMAIL_PROVIDER is resend or postmark; without it, email prints to the console.
EMAIL_PROVIDER=
EMAIL_API_KEY=
DEFAULT_FROM_EMAIL=

# Phase 8: form video storage (S3-compatible bucket)
STORAGE_BUCKET=
STORAGE_ACCESS_KEY=
STORAGE_SECRET=
STORAGE_ENDPOINT=

# Optional error tracking
SENTRY_DSN=
